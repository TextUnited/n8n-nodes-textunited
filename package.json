{
	"name": "@textunited/n8n-nodes-textunited",
	"version": "0.7.1",
	"description": "n8n community node to create and manage TextUnited translation projects",
	"license": "MIT",
	"homepage": "https://github.com/TextUnited/n8n-nodes-textunited",
	"keywords": [
		"n8n-community-node-package",
		"textunited",
		"translation",
		"localization"
	],
	"author": {
		"name": "TextUnited",
		"email": "dev@textunited.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TextUnited/n8n-nodes-textunited.git"
	},
	"publishConfig": {
		"registry": "https://npm.textunited.com/"
	},
	"engines": {
		"node": ">=20"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TextUnitedApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TextUnited/TextUnited.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
